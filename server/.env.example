# Massy Purchasing — server configuration TEMPLATE
# Copy to .env for local development. Real values NEVER go in the repo (A.8.9);
# in production, secrets come from Azure Key Vault / DPAPI-protected config (§2).

NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001

# PostgreSQL 16. Production uses a per-environment service account granted the
# massy_app role (A.8.31: separate credentials per environment).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/massy_purchasing

# 64+ hex chars; sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS

# Encrypts the break-glass TOTP secret at rest (A.5.17). Same generation as above.
BREAK_GLASS_KEY=CHANGE_ME_64_HEX_CHARS

# entra = Microsoft Entra ID OIDC (production). dev = seeded synthetic users,
# refused when NODE_ENV=production.
AUTH_MODE=dev

# Required when AUTH_MODE=entra (values from the Entra app registration — §2 ask list item 4)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://purchasing.massymotors.local/api/auth/callback

# Serve the built SPA from this directory when set (production)
WEB_DIST_DIR=

# Reverse-proxy trust for client IPs. NEVER "true" (spoofable X-Forwarded-For
# would defeat rate limits and falsify audit rows). Either a hop count ("1")
# or a comma-separated list of proxy IPs/CIDRs; "false" when listening direct.
TRUST_PROXY=false

# Path to the CA bundle for verified TLS to PostgreSQL (A.8.24). Required in
# production where app and DB sit on separate VLANs; also add
# sslmode=verify-full to DATABASE_URL there.
DB_SSL_CA_FILE=

LOG_LEVEL=info

# ── Attachments & malware scanning (A.8.7) ───────────────────────────────────
# Private store — never a directory the web server serves or executes from.
ATTACHMENT_DIR=./data/attachments
# clamd = ClamAV daemon (REQUIRED in production); stub = dev/test EICAR-only
# detector, refused when NODE_ENV=production.
SCANNER_MODE=stub
CLAMD_HOST=
CLAMD_PORT=3310
# Transport ceiling for uploads: bodies above this are aborted while streaming
# rather than buffered and then rejected. Keep >= the attachment_max_bytes
# setting in app_settings (15 MiB by default); raise both together.
UPLOAD_TRANSPORT_LIMIT_MB=20

# ── Notification email (plan §5.2 / A.5.14) ─────────────────────────────────
# off = messages stay queued in notification_outbox (dev, or until Massy IT
# provides the SMTP relay — §2 ask list). smtp = deliver via internal relay.
EMAIL_MODE=off
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Massy Purchasing <purchasing@massymotors.local>"
